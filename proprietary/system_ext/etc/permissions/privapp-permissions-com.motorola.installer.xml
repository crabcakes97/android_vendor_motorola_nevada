<?xml version="1.0" encoding="utf-8" ?>
<permissions>
        <privapp-permissions package="com.motorola.installer">
        <!-- Allows the app to install packages programmatically -->
        <permission name="android.permission.INSTALL_PACKAGES" />
        <!-- Allows the app to silently uninstall packages without user confirmation -->
        <permission name="android.permission.DELETE_PACKAGES" />
        <!-- Allows the app to request deletion of packages (shows uninstall UI) -->
        <permission name="android.permission.REQUEST_DELETE_PACKAGES" />
        <!-- Requests permission to allow installer to update ownership for an application -->
        <permission name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
        <permission name="android.permission.INSTALL_PACKAGE_UPDATES"/>
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <permission name="android.permission.POST_NOTIFICATIONS"/>
        <permission name="android.permission.QUERY_ALL_PACKAGES"/>
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    </privapp-permissions>
</permissions>

